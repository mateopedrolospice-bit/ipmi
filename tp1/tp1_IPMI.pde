PImage img;

void setup(){
  size(800, 400);
  img = loadImage("cubismo1.png");
}

  void draw(){
    background(200);
    image(img, 0, 0, 400, 400);
    translate(100 + 110 - 300, height/2 - 300);
    
    pushMatrix();
   translate(400, 0)
   
   
  // =====================
  // MACETA
  // =====================

  ;fill(70, 130, 170);
  quad(250, 400, 350, 400, 370, 500, 230, 500);

  fill(50, 100, 140);
  triangle(250, 400, 300, 430, 230, 500);

  fill(90, 160, 190);
  triangle(300, 430, 350, 400, 370, 500);

  fill(30, 80, 120);
  triangle(300, 430, 280, 500, 370, 500);

  fill(110, 180, 200);
  triangle(300, 430, 320, 470, 280, 500);

  // =====================
  // TALLO CENTRAL
  // =====================

  fill(120, 200, 120);
  quad(280, 250, 320, 250, 330, 400, 270, 400);

  fill(90, 170, 100);
  triangle(280, 250, 300, 280, 270, 400);

  fill(140, 220, 140);
  triangle(300, 280, 320, 250, 330, 400);

  fill(100, 180, 110);
  triangle(300, 280, 290, 340, 310, 360);

  // base
  fill(110, 190, 120);
  triangle(280, 400, 300, 370, 320, 400);

  fill(90, 160, 110);
  triangle(270, 400, 300, 430, 280, 400);

  fill(120, 200, 130);
  triangle(320, 400, 300, 430, 330, 400);

  // punta superior
  fill(130, 210, 130);
  triangle(280, 250, 300, 205, 320, 250);

  fill(170, 240, 160);
  triangle(300, 205, 310, 235, 290, 235);

  // =====================
  // BRAZO IZQUIERDO
  // =====================

  fill(110, 190, 110);
  quad(260, 300, 220, 260, 200, 300, 240, 340);

  fill(80, 160, 90);
  triangle(220, 260, 210, 290, 240, 340);

  fill(100, 180, 110);
  triangle(220, 260, 240, 300, 230, 320);

  fill(90, 170, 100);
  triangle(230, 320, 215, 310, 240, 300);

  // unión
  fill(120, 200, 120);
  triangle(260, 300, 280, 280, 250, 310);

  // punta
  fill(130, 210, 130);
  triangle(210, 240, 230, 240, 220, 260);

  fill(170, 240, 160);
  triangle(220, 260, 225, 245, 215, 245);

  // =====================
  // BRAZO DERECHO
  // =====================

  fill(110, 190, 110);
  quad(340, 300, 380, 260, 400, 300, 360, 340);

  fill(80, 160, 90);
  triangle(380, 260, 390, 290, 360, 340);

  fill(100, 180, 110);
  triangle(380, 260, 360, 300, 370, 320);

  fill(90, 170, 100);
  triangle(370, 320, 385, 310, 360, 300);

  // unión con tallo
  fill(120, 200, 120);
  triangle(340, 300, 320, 280, 350, 310);

  // punta
  fill(130, 210, 130);
  triangle(370, 240, 390, 240, 380, 260);

  fill(170, 240, 160);
  triangle(380, 260, 385, 245, 375, 245);

  // =====================
  // DETALLES FINALES
  // =====================

  strokeWeight(1);

  // tallo
  line(300, 205, 300, 400);
  line(285, 300, 315, 320);
  line(290, 340, 310, 360);

  // maceta
  line(250, 400, 350, 400);
  line(300, 430, 280, 500);
  line(300, 430, 370, 500);

  // brazos
  line(220, 260, 240, 340);
  line(380, 260, 360, 340);
  line(230, 300, 210, 290);
  line(370, 300, 390, 290);

  noLoop();

textSize(30);
  text((mouseX - 400) + "-" + mouseY, mouseX - 400, mouseY);
  
  noStroke();
  
  popMatrix();
}
